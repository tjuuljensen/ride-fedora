{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjuuljensen/ride-fedora/schemas/catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "clientVersion", "operations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 3},
    "clientVersion": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "target": {
      "type": "object", "required": ["releases", "architectures"], "additionalProperties": false,
      "properties": {
        "releases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}},
        "variantIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}}
      }
    },
    "sourceProvider": {
      "type": "object",
      "required": ["sourceId", "handler", "packageName", "artifactFormat", "status", "recovery", "targets", "sourceUri", "verification"],
      "additionalProperties": false,
      "properties": {
        "sourceId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "handler": {"const": "dnf-package"},
        "packageName": {"type": "string", "pattern": "^[A-Za-z0-9+_.-]+$"},
        "artifactFormat": {"const": "rpm"},
        "status": {"enum": ["candidate", "supported"]},
        "acceptanceEvidence": {"type": "string", "pattern": "^docs/acceptance/[a-z0-9._-]+\\.md$"},
        "recovery": {"const": "remove-new-install"},
        "targets": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/target"}},
        "sourceUri": {"type": "string", "pattern": "^https://"},
        "verification": {"const": "fedora-repository-gpg"}
      }
    },
    "operation": {
      "type": "object",
      "required": ["id", "kind", "name", "group", "description", "handler", "states", "scope", "status", "recovery", "targets", "productId", "productUri", "license", "licenseUri", "sourceUri", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(package|setting|artifact|system)\\.[a-z0-9.-]+$"},
        "kind": {"enum": ["package", "setting", "artifact", "system"]},
        "name": {"type": "string", "minLength": 1},
        "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "description": {"type": "string", "minLength": 1},
        "handler": {"enum": ["dnf-package", "systemd-service", "github-asset", "python-venv", "pinned-script", "pinned-zip", "gsettings-boolean", "ibus-emoji-hotkey", "gsettings-string", "upower-threshold"]},
        "distribution": {"const": "installed"},
        "deploymentId": {"const": "local-installed"},
        "artifactFormat": {"enum": ["rpm", "wheel", "script", "zip", "sdist"]},
        "sourceId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "sourceProviders": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sourceProvider"}},
        "packageName": {"type": "string", "pattern": "^[A-Za-z0-9+_.-]+$"},
        "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]+\\.service$"},
        "valueKind": {"enum": ["locale", "window-buttons", "percentage-low"]},
        "allowedValues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "githubRepository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "assetSuffix": {"type": "string", "pattern": "^-[A-Za-z0-9_.-]+$"},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["installed", "absent", "enabled", "disabled", "configured", "downloaded"]}},
        "scope": {"enum": ["system", "user"]},
        "status": {"enum": ["candidate", "supported"]},
        "recovery": {"enum": ["remove-new-install", "exact-state", "none"]},
        "acceptanceEvidence": {"type": "string", "pattern": "^docs/acceptance/[a-z0-9._-]+\\.md$"},
        "targets": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/target"}},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^package\\.[a-z0-9.-]+$"}},
        "productId": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "productUri": {"type": "string", "pattern": "^https://"},
        "license": {"type": "string", "minLength": 1},
        "licenseUri": {"type": "string", "pattern": "^https://"},
        "sourceUri": {"type": "string", "pattern": "^https://"},
        "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "licenseSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification": {"enum": ["fedora-repository-gpg", "local-systemd-state", "local-gsettings-state", "local-upower-config", "github-release-sha256-observed", "github-release-api-sha256", "github-commit-sha256-observed", "pypi-pinned-sha256", "pypi-sdist-sha256"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "package"}}}, "then": {"required": ["distribution", "deploymentId", "artifactFormat", "sourceId"], "oneOf": [{"properties": {"states": {"const": ["installed", "absent"]}, "recovery": {"const": "remove-new-install"}}}, {"properties": {"states": {"const": ["installed"]}, "recovery": {"const": "none"}}}]}, "else": {"not": {"anyOf": [{"required": ["distribution"]}, {"required": ["deploymentId"]}, {"required": ["artifactFormat"]}, {"required": ["sourceId"]}, {"required": ["sourceProviders"]}]}}},
        {"if": {"properties": {"handler": {"const": "dnf-package"}}}, "then": {"required": ["packageName"], "properties": {"kind": {"const": "package"}, "artifactFormat": {"const": "rpm"}}}},
        {"if": {"properties": {"handler": {"const": "systemd-service"}}}, "then": {"required": ["serviceName"], "properties": {"kind": {"const": "setting"}, "states": {"const": ["enabled", "disabled"]}}}},
        {"if": {"properties": {"handler": {"const": "gsettings-boolean"}}}, "then": {"properties": {"kind": {"const": "setting"}, "scope": {"const": "user"}, "states": {"const": ["enabled", "disabled"]}, "id": {"enum": ["setting.gnome-clock-date", "setting.gnome-calendar-week-numbers", "setting.gnome-primary-paste", "setting.gnome-location", "setting.gnome-problem-reporting"]}, "verification": {"const": "local-gsettings-state"}, "recovery": {"const": "exact-state"}}}},
        {"if": {"properties": {"handler": {"const": "ibus-emoji-hotkey"}}}, "then": {"properties": {"id": {"const": "setting.ibus-emoji-hotkey"}, "kind": {"const": "setting"}, "scope": {"const": "user"}, "states": {"const": ["enabled"]}, "verification": {"const": "local-gsettings-state"}, "recovery": {"const": "exact-state"}}}},
        {"if": {"properties": {"handler": {"const": "gsettings-string"}}}, "then": {"required": ["valueKind"], "properties": {"id": {"enum": ["setting.gnome-region", "setting.gnome-window-buttons"]}, "kind": {"const": "setting"}, "scope": {"const": "user"}, "states": {"const": ["configured"]}, "valueKind": {"enum": ["locale", "window-buttons"]}, "verification": {"const": "local-gsettings-state"}, "recovery": {"const": "exact-state"}}}},
        {"if": {"properties": {"handler": {"const": "upower-threshold"}}}, "then": {"required": ["valueKind"], "properties": {"id": {"const": "setting.upower-percentage-low"}, "kind": {"const": "setting"}, "scope": {"const": "system"}, "states": {"const": ["configured"]}, "valueKind": {"const": "percentage-low"}, "verification": {"const": "local-upower-config"}, "recovery": {"const": "exact-state"}}}},
        {"if": {"properties": {"handler": {"const": "github-asset"}}}, "then": {"required": ["githubRepository", "assetSuffix", "maxBytes"], "properties": {"kind": {"const": "artifact"}, "states": {"const": ["downloaded"]}}}},
        {"if": {"properties": {"handler": {"const": "python-venv"}}}, "then": {"properties": {"id": {"enum": ["package.volatility3", "package.dfir-unfurl", "package.chepy"]}, "kind": {"const": "package"}, "artifactFormat": {"enum": ["wheel", "sdist"]}, "states": {"const": ["installed", "absent"]}}}},
        {"if": {"properties": {"id": {"const": "package.chepy"}}}, "then": {"required": ["sourceSha256"], "properties": {"handler": {"const": "python-venv"}, "scope": {"const": "user"}, "artifactFormat": {"const": "sdist"}, "sourceId": {"const": "pypi-sdist-venv"}, "verification": {"const": "pypi-sdist-sha256"}, "sourceUri": {"const": "https://files.pythonhosted.org/packages/3f/4c/b8bc1607c96e1df206912e4db82ace5adfb2fe9dce5926fd7860d265fa58/chepy-7.6.0.tar.gz"}, "sourceSha256": {"const": "f6084689e43d128748c18f79c79d75539abb67ac8245e950b678cfa0da2f5010"}}}},
        {"if": {"properties": {"handler": {"const": "pinned-script"}}}, "then": {"required": ["sourceSha256", "licenseSha256"], "properties": {"id": {"const": "package.asn"}, "kind": {"const": "package"}, "scope": {"const": "user"}, "artifactFormat": {"const": "script"}, "sourceId": {"const": "github-raw-pinned"}, "verification": {"const": "github-commit-sha256-observed"}, "states": {"const": ["installed", "absent"]}, "sourceUri": {"pattern": "^https://raw\\.githubusercontent\\.com/nitefood/asn/[0-9a-f]{40}/asn$"}, "licenseUri": {"pattern": "^https://raw\\.githubusercontent\\.com/nitefood/asn/[0-9a-f]{40}/LICENSE$"}}}},
        {"if": {"properties": {"handler": {"const": "pinned-zip"}}}, "then": {"required": ["sourceSha256", "licenseSha256"], "properties": {"id": {"const": "package.cyberchef"}, "kind": {"const": "package"}, "scope": {"const": "system"}, "artifactFormat": {"const": "zip"}, "sourceId": {"const": "github-release-pinned"}, "verification": {"const": "github-release-api-sha256"}, "states": {"const": ["installed", "absent"]}, "sourceUri": {"const": "https://github.com/gchq/CyberChef/releases/download/v11.5.0/CyberChef_8cd426dd4f40f1423912d5fad91b578a86a65112.zip"}, "licenseUri": {"const": "https://raw.githubusercontent.com/gchq/CyberChef/v11.5.0/LICENSE"}, "sourceSha256": {"const": "f6478925d3eaa16ec08626a85f5b85eed10d531a5e18700615fed7ecb024cccf"}, "licenseSha256": {"const": "58d1e17ffe5109a7ae296caafcadfdbe6a7d176f0bc4ab01e12a689b0499d8bd"}}}}
      ]
    }
  }
}
